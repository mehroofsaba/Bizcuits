# --- Required in production ---
SECRET_KEY=change-me-to-a-long-random-string
# Free Postgres (Neon or Supabase) so data survives Render free-plan restarts. Leave empty to use local SQLite.
DATABASE_URL=
# --- AI (leave GEMMA_BACKEND empty to use the free built-in templates) ---
# "gemini" = hosted Gemma through Google AI Studio (free tier works), "ollama" = self-hosted Gemma
GEMMA_BACKEND=
GEMMA_MODEL=gemma-3-27b-it
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_LIMIT_PER_HOUR=40

# --- Password reset email (Render free blocks SMTP, so use Resend's HTTPS API: free tier at resend.com) ---
RESEND_API_KEY=
MAIL_FROM=Bizcuits <onboarding@resend.dev>
# SMTP fallback for hosts that allow it
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Public URL of your deployed app (used in reset links and Stripe redirects)
APP_URL=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Scheduled posts: an external pinger calls /api/cron/run?key=CRON_SECRET every few minutes ---
CRON_SECRET=
